# Copy to /etc/fractonica/api.env with mode 0600. Do not commit real values.
DATABASE_URL=postgresql://fractonica:URL_SAFE_PASSWORD@127.0.0.1:5432/fractonica
AUTH_JWT_PRIVATE_KEY_BASE64=BASE64_PKCS8_ED25519_PRIVATE_KEY
AUTH_JWT_ISSUER=fractonica-api
AUTH_JWT_AUDIENCE=fractonica-clients
AUTH_JWT_KEY_ID=primary
AUTH_REGISTRATION_MODE=closed
AUTH_ARGON2_MAX_CONCURRENCY=1
TRUST_PROXY_HOPS=1
LOG_LEVEL=info
DB_POOL_MAX=5
DB_CONNECTION_TIMEOUT_MS=5000
DB_READINESS_TIMEOUT_MS=2000
MEDIA_MAX_BYTE_LENGTH=5368709120
MEDIA_UPLOAD_TTL_SECONDS=86400
